class solution:
    def compareversion(self,version1,version2):
        v1 =version1.split(".")
        v2 =version2.split(".")
        for i in range(max(len(v1),len(v2))):
            a = int(v1[i]) if i < len(v1) else 0
            b = int(v2[i]) if i < len(v2) else 0
            if a > b:
                return 1
            elif a < b:
                return -1
        return 0
solution = solution()
version1 ="1.2"
version2 ="1.10"
result = solution.compareversion(version1,version2)
print("version1:", version1)
print("version2:", version2)
print("comparison result:", result)
