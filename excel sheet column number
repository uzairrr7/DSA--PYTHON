
class Solution:
    def titleToNumber(self, columnTitle):
        result = 0

        for char in columnTitle:
            value = ord(char) - ord('A') + 1
            result = result * 26 + value

        return result


solution = Solution()

columnTitle = "AB"
answer = solution.titleToNumber(columnTitle)

print("Excel column:", columnTitle)
print("Column number:", answer)
