class solution:
   def findmin(self,nums):
       left = 0
       right = len(nums) - 1

       while left < right:
           mid = ( left + right) // 2
           if nums[mid] > nums[right]:
              left = mid + 1
           else:
              right = mid
        return  nums[left]
solution = solution()
nums = [3,4,5,1,2]
result = solution.findmin(nums)
print("array:" , nums)
print("minimum:" , result)
