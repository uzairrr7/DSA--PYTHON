class solution:
    def uniqchar(self,s):
        count = {}

        for char in s:
            if char in count:
                count[char] += 1
            else:
                count[char] = 1
        for i in range(len(s)):
            if count[s[i]] == 1:
                return i
        return - 1
solution = solution()
s = "leetcode"
result = solution.uniqchar(s)
print("first unique character:", result)
