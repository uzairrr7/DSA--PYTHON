class solution:
    def max(self,gas,cost):
        total = 0 
        tank = 0
        start = 0

     for i in range(len(gas)):
         difference = gas[i] - cost[i]
         total += difference
         tank += difference

        if tank < 0:
             start = i + 1
             tank = 0

      if total < 0:
           return - 1
        return start

solution = solution()
gas = [1,2,3,4,5]
cost= [3,4,5,1,2]
result = solution.max(gas,cost)
print("gas:", gas)
print("cost:", cost)
print("starting station:", result)

