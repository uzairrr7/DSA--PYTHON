class solution:
    def isomorphic(self,s,t):
        if len(s) != len(t):
            return False
        mapping_s_t = {}
        mapping_t_s = {}
        for i in range(len(s)):
            char_s = s[i]
            char_t = t[i]

            if char_s in mapping_s_t:
                if mapping_s_t[char_s] != char_t:
                    return False
            mapping_s_t[char_s] = char_t
            mapping_t_s[char_t] = char_s
        return True
solution = solution()
s="egg" 
t="add"
result = solution.isomorphic(s,t)
print("string 1:", s)
print("string 2:", t)
print("IS ISOMORPHIC:", result)
