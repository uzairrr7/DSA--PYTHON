
class Solution:
    def longestPalindrome(self, s):
        counts = {}
        for char in s:
            counts[char] = counts.get(char, 0) + 1

        length = 0
        has_middle = False

        for count in counts.values():
            length += (count // 2) * 2
            if count % 2 == 1:
                has_middle = True

        if has_middle:
            length += 1

        return length


solution = Solution()

s = "abccccdd"
result = solution.longestPalindrome(s)

print("Input:", s)
print("Longest palindrome length:", result)
