class solution:
    def maxsubarray(self,nums):
        max_sum = float('-inf')
        current_sum = 0

        for num in nums[1:]:
            current_sum = max(num,current_sum + num)
            max_sum = max(max_sum , current_sum)
        return max_sum

 solution = solution()
 nums = [ -2, 1 , -3 , 4 , -1, 2 , 1 , -5 , 4]
 result = solution.maxsubarray(nums)
 print("nums" , nums)
 print("maximum subarray sum" , result )
 
