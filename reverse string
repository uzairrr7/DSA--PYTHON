class solution:
   def reversestring(self,s):
     left = 0
     right = len(s) - 1
     while left < right:
          s[left], s[right] = s[right] , s[left]
          left += 1
          right -= 1
     return s
solution = solution()
s = ["h" , "e" , "l" , "l" ,"o"]
result = solution.reversestring(s)
print("reversed string:" , result)
