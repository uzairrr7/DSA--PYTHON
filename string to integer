
class Solution:
    def myAtoi(self, s):
        i = 0
        n = len(s)

        while i < n and s[i] == " ":
            i += 1

        sign = 1
        if i < n and s[i] in "+-":
            if s[i] == "-":
                sign = -1
            i += 1

        number = 0
        limit = 2147483647 if sign == 1 else 2147483648

        while i < n and s[i].isdigit():
            digit = int(s[i])

            if number > (limit - digit) // 10:
                return limit if sign == 1 else -limit

            number = number * 10 + digit
            i += 1

        return sign * number


solution = Solution()

s = "   -42 with words"
result = solution.myAtoi(s)

print("Input:", repr(s))
print("Converted integer:", result)
