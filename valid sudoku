class solution:
    def isvalidsudoku(self,board):
        rows = [set() for _ in range(9)]
        columns = [set() for _ in range(9)]
        boxes = [set() for _ in range(9)]

        for i in range(9):
            for j in range(9):
                if board[i][j] == "-":
                    continue
                num = board[i][j]

                box_index = (i // 3) * 3 + (j//3)

                if num in rows[i]:
                    return False
                if num in columns[j]:
                    return False
                if num in boxes[box_index]:
                    return False
                rows[i].add(num)
                columns[j].add(num)
                boxes[box_index].add(num)

        return True


solution = solution()

